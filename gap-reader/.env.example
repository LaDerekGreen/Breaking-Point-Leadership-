# Organizational Gap Reader database: the gr_org role, the org schema only.
ORG_DATABASE_URL="postgresql://gr_org:gr_org_dev_password@localhost:5432/gapreader?schema=org"
# The same database, unpooled, for migrations. Locally, identical to the line above.
# On a pooled host (Neon, Supabase), the pooled URL goes above and the direct URL here.
ORG_DIRECT_DATABASE_URL="postgresql://gr_org:gr_org_dev_password@localhost:5432/gapreader?schema=org"
# Personal Gap Reader database: the gr_personal role, the personal schema only.
PERSONAL_DATABASE_URL="postgresql://gr_personal:gr_personal_dev_password@localhost:5432/gapreader?schema=personal"
PERSONAL_DIRECT_DATABASE_URL="postgresql://gr_personal:gr_personal_dev_password@localhost:5432/gapreader?schema=personal"
# Used only by db/setup.sql and the integration tests (a superuser connection).
DATABASE_ADMIN_URL="postgresql://postgres@localhost:5432/gapreader"

# Auth.js secret (openssl rand -base64 33). Signs both auth instances' cookies.
AUTH_SECRET=""
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the organization's
# AI key at rest. Never used for personal records, which are encrypted in the
# browser under the user's own passphrase.
APP_ENCRYPTION_KEY=""
APP_URL="http://localhost:3000"

# Magic link email. If SMTP_URL is empty, links are printed to the server log
# (development only).
SMTP_URL=""
EMAIL_FROM="Gap Reader <no-reply@example.org>"

# Optional SSO for the Organizational Gap Reader (OIDC).
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_NAME="Company SSO"

# The first program lead. This email may sign in before the directory exists
# and is given the program_lead role on first sign in.
BOOTSTRAP_PROGRAM_LEAD_EMAIL=""

# Bearer token for the import API (POST /api/org/import/<kind>).
IMPORT_API_TOKEN=""
